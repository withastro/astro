{
  "name": "@astrojs/sqlite",
  "description": "Experimental: mirror content collections into SQLite and query them through a live loader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "withastro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/astro.git",
    "directory": "packages/integrations/sqlite"
  },
  "keywords": [
    "astro-integration",
    "sqlite",
    "content-collections"
  ],
  "bugs": "https://github.com/withastro/astro/issues",
  "exports": {
    ".": "./dist/index.js",
    "./loader": "./dist/loader.js",
    "./runtime/node": "./dist/runtime/node.js",
    "./runtime/d1": "./dist/runtime/d1.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "astro-scripts build \"src/**/*.ts\" && tsc -b",
    "build:ci": "astro-scripts build \"src/**/*.ts\"",
    "dev": "astro-scripts dev \"src/**/*.ts\"",
    "test": "astro-scripts test --timeout 100000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "devalue": "^5.9.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "workspace:*",
    "astro-scripts": "workspace:*",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
