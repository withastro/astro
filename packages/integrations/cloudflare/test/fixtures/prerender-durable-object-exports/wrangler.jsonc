{
  "name": "prerender-durable-object-exports",
  "main": "./src/worker.js",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXAMPLE_DO",
        "class_name": "ExampleDO"
      }
    ]
  },
  "exports": {
    "ExampleDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
