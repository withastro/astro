---
import { Image, Picture, getImage } from 'astro:assets';
import penguin from '../assets/penguin.jpg';

const explicit = await getImage({ src: penguin, width: 64, format: 'avif' });
---

<html lang="en">
	<head>
		<title>Default image service, static output</title>
	</head>
	<body>
		<Image id="image" src={penguin} alt="penguin" width={100} height={100} />
		<Picture id="picture" src={penguin} alt="penguin" widths={[50, 100]} formats={['avif']} />
		<img id="get-image" src={explicit.src} alt="penguin" />
	</body>
</html>
