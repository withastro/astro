{
  "name": "@astrojs/mdx",
  "description": "Add support for MDX pages in your Astro site",
  "version": "8.0.3",
  "type": "module",
  "author": "withastro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/astro.git",
    "directory": "packages/integrations/mdx"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "mdx"
  ],
  "bugs": "https://github.com/withastro/astro/issues",
  "homepage": "https://docs.astro.build/en/guides/integrations-guide/mdx/",
  "exports": {
    ".": "./dist/index.js",
    "./container-renderer": "./dist/container-renderer.js",
    "./server.js": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "astro-scripts build \"src/**/*.ts\" && tsc -b",
    "build:ci": "astro-scripts build \"src/**/*.ts\"",
    "dev": "astro-scripts dev \"src/**/*.ts\"",
    "test": "astro-scripts test --timeout 70000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/internal-helpers": "workspace:*",
    "@astrojs/markdown-satteri": "workspace:*",
    "es-module-lexer": "^3.0.3"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/markdown-satteri": "^0.4.0",
    "astro": "^7.2.10"
  },
  "peerDependenciesMeta": {
    "@astrojs/markdown-remark": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "workspace:*",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/twoslash": "^4.5.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "astro": "workspace:*",
    "astro-scripts": "workspace:*",
    "cheerio": "1.2.0",
    "linkedom": "^0.18.13",
    "rehype-mathjax": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satteri": "^0.10.5",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
