{
  "name": "@astrojs/image-napi",
  "description": "An Astro image service powered by @napi-rs/image",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "withastro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/astro.git",
    "directory": "packages/image-napi"
  },
  "bugs": "https://github.com/withastro/astro/issues",
  "exports": {
    ".": "./dist/index.js",
    "./service": "./dist/service.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "astro-scripts build \"src/**/*.ts\" && tsc -b",
    "build:ci": "astro-scripts build \"src/**/*.ts\"",
    "dev": "astro-scripts dev \"src/**/*.ts\"",
    "test": "astro-scripts test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@napi-rs/image": "^1.15.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "workspace:*",
    "astro-scripts": "workspace:*",
    "cheerio": "1.2.0",
    "sharp": "^0.35.4"
  },
  "keywords": [
    "astro",
    "image-service"
  ]
}
