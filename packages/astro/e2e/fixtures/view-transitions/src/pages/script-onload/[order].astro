---
import {ClientRouter} from "astro:transitions";

export function getStaticPaths() {
	return ['load-src-first', 'load-attr-first', 'error-src-first', 'error-attr-first'].map(
		(order) => ({ params: { order } }),
	);
}

const { order } = Astro.params;
---
<html>
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<title>Script onload {order}</title>
		<script is:inline>
			document.addEventListener('astro:page-load', () => {
				(window.scriptEvents ??= []).push('page-load');
				document.getElementById('page-load').textContent = 'fired';
			}, { once: true });
		</script>
		{order === 'load-src-first' && <script is:inline src="data:text/javascript," onload="(window.scriptEvents ??= []).push('onload')"></script>}
		{order === 'load-attr-first' && <script is:inline onload="(window.scriptEvents ??= []).push('onload')" src="data:text/javascript,"></script>}
		{order === 'error-src-first' && <script is:inline src="/script-onload-missing.js" onerror="(window.scriptEvents ??= []).push('onerror')"></script>}
		{order === 'error-attr-first' && <script is:inline onerror="(window.scriptEvents ??= []).push('onerror')" src="/script-onload-missing.js"></script>}
	</head>
	<body>
		<p id="page-load"></p>
	</body>
</html>
