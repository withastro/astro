---
import { getImage } from "astro:assets";
import fromPaths from "../../assets/staticPaths.jpg";

export async function getStaticPaths() {
	const image = await getImage({ src: fromPaths, width: 20, format: "webp" });
	return [{ params: { slug: "one" }, props: { src: image.src } }];
}

const { src } = Astro.props;
---

<img id="from-paths" src={src} alt="Optimized in getStaticPaths, so only the optimized file exists" />
