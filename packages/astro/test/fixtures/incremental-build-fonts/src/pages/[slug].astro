---
import { Font } from 'astro:assets';

export function getStaticPaths() {
	return [{ params: { slug: 'a' }, props: {}, cacheKey: 'v1' }];
}
const { slug } = Astro.params;
---

<html>
	<head>
		<title>{slug}</title>
		<Font cssVariable="--font-roboto" preload />
	</head>
	<body>
		<h1>{slug}</h1>
	</body>
</html>
