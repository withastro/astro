{
  "name": "@astrojs/vite-plugin-astro",
  "description": "Vite plugin for the Astro component language.",
  "version": "0.0.0",
  "type": "module",
  "author": "withastro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/astro.git",
    "directory": "packages/vite-plugin-astro"
  },
  "bugs": "https://github.com/withastro/astro/issues",
  "homepage": "https://astro.build",
  "exports": {
    ".": "./dist/index.js",
    "./defaults": "./dist/defaults.js",
    "./internal/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublish": "pnpm build",
    "prebuild": "astro-scripts prebuild --to-string \"src/runtime/server/astro-island.ts\" \"src/runtime/client/{idle,load,media,only,visible}.ts\"",
    "build": "pnpm run prebuild && astro-scripts build \"src/**/*.ts\" && tsc -b",
    "build:ci": "pnpm run prebuild && astro-scripts build \"src/**/*.ts\"",
    "dev": "astro-scripts dev --prebuild \"src/runtime/server/astro-island.ts\" --prebuild \"src/runtime/client/{idle,load,media,only,visible}.ts\" \"src/**/*.ts\"",
    "test": "astro-scripts test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.5.1",
    "@astrojs/internal-helpers": "workspace:*",
    "@oslojs/encoding": "^1.1.0",
    "clsx": "^2.1.1",
    "rolldown": "^1.2.11",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "astro-scripts": "workspace:*",
    "vite": "^8.3.3"
  },
  "keywords": [
    "astro",
    "vite",
    "vite-plugin"
  ],
  "publishConfig": {
    "provenance": true
  }
}
