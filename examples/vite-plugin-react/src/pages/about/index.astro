---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="About">
	<section class="py-12">
		<h1 class="text-4xl font-bold tracking-tight text-white">About</h1>
		<p class="mt-4 max-w-xl text-lg text-slate-400">
			An example app for the <code class="text-violet-300">astro/vite</code> spike. The
			<code class="text-violet-300">astro()</code> plugin runs the Astro integration pipeline,
			content layer, and build inside a standard Vite setup, alongside other Vite plugins
			such as Tailwind.
		</p>
	</section>
</Layout>
